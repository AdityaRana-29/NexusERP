{
  "info": {
    "name": "Mini ERP + CRM API",
    "_postman_id": "mini-erp-crm-collection",
    "description": "Run Login first — token is saved automatically to all requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin User\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin@123\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  console.log('Token saved successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@erp.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "Get All Customers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "status", "value": "Lead", "disabled": true },
                { "key": "customerType", "value": "Retail", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Customer By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", ":id"],
              "variable": [{ "key": "id", "value": "CUSTOMER_ID_HERE" }]
            }
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"John Doe\",\n  \"mobileNumber\": \"9876543210\",\n  \"email\": \"john@example.com\",\n  \"businessName\": \"Doe Enterprises\",\n  \"gstNumber\": \"29ABCDE1234F1Z5\",\n  \"customerType\": \"Wholesale\",\n  \"address\": \"123 Main St, Mumbai, Maharashtra\",\n  \"status\": \"Lead\",\n  \"followUpDate\": \"2026-09-01T00:00:00.000Z\",\n  \"notes\": \"Interested in bulk orders\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers"]
            }
          }
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Active\",\n  \"notes\": \"Converted to active customer\",\n  \"followUpDate\": \"2026-10-01T00:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", ":id"],
              "variable": [{ "key": "id", "value": "CUSTOMER_ID_HERE" }]
            }
          }
        },
        {
          "name": "Delete Customer",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", ":id"],
              "variable": [{ "key": "id", "value": "CUSTOMER_ID_HERE" }]
            }
          }
        },
        {
          "name": "Add Follow-Up Note",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Called customer, interested in new product line.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers/:id/notes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", ":id", "notes"],
              "variable": [{ "key": "id", "value": "CUSTOMER_ID_HERE" }]
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "category", "value": "Electronics", "disabled": true },
                { "key": "lowStockOnly", "value": "true", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Product By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", ":id"],
              "variable": [{ "key": "id", "value": "PRODUCT_ID_HERE" }]
            }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productName\": \"Wireless Mouse\",\n  \"SKU\": \"WM-001\",\n  \"category\": \"Electronics\",\n  \"unitPrice\": 799.99,\n  \"currentStock\": 50,\n  \"minimumStockAlert\": 10,\n  \"warehouseLocation\": \"Shelf A-12\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unitPrice\": 899.99,\n  \"minimumStockAlert\": 15,\n  \"warehouseLocation\": \"Shelf B-5\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", ":id"],
              "variable": [{ "key": "id", "value": "PRODUCT_ID_HERE" }]
            }
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", ":id"],
              "variable": [{ "key": "id", "value": "PRODUCT_ID_HERE" }]
            }
          }
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "Get Stock Movements",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stock-movement?page=1&limit=15",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stock-movement"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "15" },
                { "key": "productId", "value": "", "disabled": true },
                { "key": "movementType", "value": "IN", "disabled": true },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Record Stock Movement",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"PRODUCT_ID_HERE\",\n  \"quantityChanged\": 20,\n  \"movementType\": \"IN\",\n  \"reason\": \"Restocked from supplier\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/stock-movement",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stock-movement"]
            }
          }
        }
      ]
    },
    {
      "name": "Challans",
      "item": [
        {
          "name": "Get All Challans",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/challans?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "challans"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "status", "value": "Draft", "disabled": true },
                { "key": "customerId", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Challan By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/challans/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "challans", ":id"],
              "variable": [{ "key": "id", "value": "CHALLAN_ID_HERE" }]
            }
          }
        },
        {
          "name": "Create Challan",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUSTOMER_ID_HERE\",\n  \"status\": \"Draft\",\n  \"items\": [\n    {\n      \"productId\": \"PRODUCT_ID_HERE\",\n      \"quantity\": 5\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/challans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "challans"]
            }
          }
        },
        {
          "name": "Update Challan Status",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Confirmed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/challans/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "challans", ":id", "status"],
              "variable": [{ "key": "id", "value": "CHALLAN_ID_HERE" }]
            }
          }
        }
      ]
    }
  ]
}
